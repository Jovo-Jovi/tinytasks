{
  "base": "main",
  "maxAttempts": 3,
  "repo": "jovo-jovi/tinytasks",
  "reviewer": {
    "cli": "cursor",
    "command": "agent",
    "model": "grok-4.7-xhigh"
  },
  "lightReviewer": {
    "same": true,
    "cli": "cursor",
    "model": "grok-4.7-xhigh"
  },
  "builder": {
    "cli": "cursor",
    "command": "agent",
    "model": "grok-4.7-high"
  },
  "builderPool": [
    {
      "cli": "cursor",
      "command": "agent",
      "model": "grok-4.7-high"
    }
  ],
  "pickPolicy": "reviewer-picks",
  "requiredChecks": {
    "install": "npm install",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint .",
    "test": "npx vitest run",
    "build": "npm run build",
    "e2e": ""
  },
  "modules": {
    "language": {
      "on": false,
      "provider": "typescript"
    },
    "styling": {
      "on": true,
      "provider": "tailwind"
    },
    "ui-kit": {
      "on": true,
      "provider": "shadcn"
    },
    "database": {
      "on": false,
      "provider": "supabase"
    },
    "auth": {
      "on": false,
      "provider": "none"
    },
    "storage": {
      "on": false,
      "provider": "supabase-storage"
    },
    "payments": {
      "on": false,
      "provider": "none"
    },
    "email": {
      "on": false,
      "provider": "none"
    },
    "jobs": {
      "on": false,
      "provider": "none"
    },
    "search": {
      "on": false,
      "provider": "none"
    },
    "product-ai": {
      "on": false,
      "provider": "none"
    },
    "i18n": {
      "on": true
    },
    "testing": {
      "on": true,
      "unit": true,
      "playwright": false
    },
    "hosting": {
      "on": true,
      "provider": "vercel"
    },
    "observability": {
      "on": false,
      "provider": "structured-logs"
    },
    "automation": {
      "on": true
    }
  },
  "languages": [
    "en",
    "ar"
  ],
  "hosting": "vercel",
  "type": "dashboard",
  "framework": "next",
  "configurationModel": {
    "cli": "cursor",
    "model": "grok-4.7-high",
    "stage": "configuration-only"
  }
}